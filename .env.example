# Normal chat: OpenUI Gateway with image search and library validation.
THESYS_API_KEY=your-thesys-api-key
THESYS_MODEL=openai/gpt-5.5
# Optional live recording provider (falls back to THESYS_API_KEY).
# OPENAI_API_KEY=your-recording-api-key
OPENAI_BASE_URL=https://api.thesys.dev/v1/embed
OPENAI_MODEL=openai/gpt-5.2
# Only set this if supported by your selected provider/model.
# REASONING_EFFORT=low
ENABLE_RECORDING_PRESET=0
