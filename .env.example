# OpenUI Gateway (default)
THESYS_API_KEY=your_thesys_api_key
THESYS_MODEL=openai/gpt-6.1-sol

# Any OpenAI-compatible API instead of Gateway, e.g. OpenRouter.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_key
# LLM_MODEL=openai/gpt-6.1-sol

# Reasoning effort for either path: low (default), medium, high, or default (send none).
# LLM_REASONING_EFFORT=low

# Local model through Ollama instead of Gateway (no API key needed).
# MODEL_PROVIDER=ollama
# OLLAMA_MODEL=qwen3.8:27b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Show the OpenUI devtools widget in the chat (development only).
# NEXT_PUBLIC_OPENUI_DEVTOOLS=1
