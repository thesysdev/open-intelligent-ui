{
  "name": "open-intelligent-ui",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openui generate src/lib/library.ts --spec --out src/generated/spec.json",
    "generate:apiKey": "openui generate-api-key",
    "prompt": "openui generate src/lib/library.ts --out src/generated/system-prompt.txt --prompt-options promptOptions && openui generate src/lib/library.ts --out src/generated/dashboard-system-prompt.txt --prompt-options dashboardPromptOptions && rm -f src/generated/*system-prompt.spec.json",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node --no-warnings scripts/bench/run.mjs",
    "deploy": "openui deploy"
  },
  "dependencies": {
    "@openuidev/lang-core": "^1.0.0",
    "@openuidev/react-lang": "^1.0.0",
    "@openuidev/react-ui": "^0.18.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^6.13.0",
    "next": "^16.3.1",
    "openai": "^6.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openuidev/cli": "0.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "26.1.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild": true,
    "@openuidev/lang-core": false
  }
}
